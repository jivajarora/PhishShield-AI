{
  "manifest_version": 3,
  "name": "PhishShield AI Extension",
  "version": "1.0",
  "description": "Real-time AI-powered phishing and scam detection.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
